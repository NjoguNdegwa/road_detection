def iou(boxA, boxB):
    # Compute intersection
    xA = max(boxA[0], boxB[0])
    yA = max(boxA[1], boxB[1])
    xB = min(boxA[2], boxB[2])
    yB = min(boxA[3], boxB[3])
    interArea = max(0, xB - xA + 1) * max(0, yB - yA + 1)

    boxAArea = (boxA[2] - boxA[0] + 1) * (boxA[3] - boxA[1] + 1)
    boxBArea = (boxB[2] - boxB[0] + 1) * (boxB[3] - boxB[1] + 1)

    iou = interArea / float(boxAArea + boxBArea - interArea)
    return iou

def average_precision(pred_boxes, true_boxes, iou_threshold=0.5):
    # Placeholder: you’d implement sorting predictions by confidence, matching, then calculating AP.
    # For brevity, just showing IoU usage.
    matches = []
    for pbox in pred_boxes:
        for tbox in true_boxes:
            if iou(pbox, tbox) >= iou_threshold:
                matches.append(1)
            else:
                matches.append(0)
    ap = sum(matches)/len(matches) if matches else 0
    return ap
